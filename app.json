{
  "expo": {
    "name": "hearth",
    "slug": "hearth",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hearth",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8d2d87bc-75fc-42c2-b838-bd81286c5557",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hearth.app"
    },
    "android": {
      "package": "com.hearth.app",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191009",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/avatars/generated/hearth-avatar-rigged.glb"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Hearth to record your optional Daily Record voice note.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hearth to choose a photo for your optional Daily Photo.",
          "cameraPermission": "Allow Hearth to take a photo for your optional Daily Photo.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "8d2d87bc-75fc-42c2-b838-bd81286c5557"
      }
    },
    "owner": "gmpaunica"
  }
}
