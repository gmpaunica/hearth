{
  "description": "Inject the protected Hearth integration or isolated worker role at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/session-role.mjs",
            "commandWindows": "node .codex\\hooks\\session-role.mjs",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
