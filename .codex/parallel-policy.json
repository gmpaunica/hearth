{
  "$schema": "hearth.parallel-policy/v1",
  "version": 1,
  "repository": "gmpaunica/hearth",
  "canonical_checkout": "C:/Windows/System32/hearth",
  "integration_branch": "app/integration",
  "worker_branch_pattern": "^codex/[a-z0-9][a-z0-9-]*$",
  "claim_label": "parallel-claim",
  "claim_marker": "hearth-parallel-claim:v1",
  "claim_warning_hours": 12,
  "claim_release_hours": 24,
  "scope_syntax": {
    "exact": "One normalized repo-relative file path.",
    "prefix": "A normalized repo-relative directory prefix ending in /."
  },
  "forbidden_worker_prefixes": [
    ".agents/",
    ".codex/",
    ".github/",
    "assets/",
    "scripts/",
    "src/",
    "supabase/",
    "tests/"
  ],
  "integrator_owned": [
    { "kind": "exact", "path": ".worktreeinclude" },
    { "kind": "prefix", "path": ".agents/skills/hearth-integrator/" },
    { "kind": "prefix", "path": ".agents/skills/hearth-worker/" },
    { "kind": "prefix", "path": ".codex/" },
    { "kind": "prefix", "path": ".github/" },
    { "kind": "prefix", "path": "scripts/parallel/" },
    { "kind": "exact", "path": "AGENTS.md" },
    { "kind": "exact", "path": "EXPERIENCE_ROADMAP.md" },
    { "kind": "exact", "path": "HANDOFF.md" },
    { "kind": "exact", "path": "STATUS.md" },
    { "kind": "exact", "path": "src/scene/Room.tsx" },
    { "kind": "exact", "path": "src/scene/rooms/RoomComposition.tsx" }
  ],
  "integration_request_only": [
    "app.json",
    "eas.json",
    "eslint.config.js",
    "google-services.json",
    "metro.config.js",
    "package-lock.json",
    "package.json",
    "tsconfig.json"
  ],
  "native_impact": [
    { "kind": "prefix", "path": "android/" },
    { "kind": "prefix", "path": "ios/" },
    { "kind": "exact", "path": "app.json" },
    { "kind": "exact", "path": "eas.json" },
    { "kind": "exact", "path": "google-services.json" },
    { "kind": "exact", "path": "package-lock.json" },
    { "kind": "exact", "path": "package.json" }
  ],
  "database_impact": [
    { "kind": "prefix", "path": "supabase/" }
  ],
  "impact_labels": {
    "native": "native-build-required",
    "database": "database-dependency"
  },
  "integration_request_label": "integration-request-approved",
  "blocked_label": "integration-blocked",
  "preview_pending_label": "preview-pending",
  "required_check": "validate",
  "merge_method": "merge",
  "preview_branch": "preview",
  "preview_environment": "preview",
  "state_file": "hearth-parallel-state.json",
  "lock_file": "hearth-parallel-integrator.lock",
  "lock_lease_minutes": 30
}
